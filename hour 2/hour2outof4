class Menu:
	def __init__(self, root):
		root.title("Menu")
		root.geometry("800x600")
		self.root = root
		
		self.menuLabel = tk.Label(self.root, text = "MENU", font=("Arial", 15))
		self.menuLabel.place(y=5, x=350, width = 100, height = 50)
		
		self.timerBtn = tk.Button(self.root, text = "timer", command = self.timerWindow)
		self.timerBtn.place(y=75, x=300, width=200, height = 50)
		
		self.progressMonitorBtn = tk.Button(self.root, text = "progress monitor", command = self.progressMonitorWindow)
		self.progressMonitorBtn.place(y=145, x = 300, width = 200, height=50)
		
		self.shopBtn = tk.Button(self.root, text = "shop", command = self.shopWindow)
		self.shopBtn.place(y=215, x = 300, width = 200, height = 50)
		
		self.lifeEventsBtn = tk.Button(self.root, text = "random life events", command = self.eventsWindow)
		self.lifeEventsBtn.place(y=285, x=300, width=200, height=50)
		
		#creates the buttons on the menu to access all features in the app
		
	def timerWindow(self):
		timerScreen = tk.Toplevel(self.root)
		screen = Timer(timerScreen)
	
	def progressMonitorWindow(self):
		progressScreen = tk.Toplevel(self.root)
		screen = ProgressMonitor(progressScreen)
	
	def shopWindow(self):
		shopScreen = tk.Toplevel(self.root)
		screen = Shop(shopScreen)
	
	def eventsWindow(self):
		eventsScreen = tk.Toplevel(self.root)
		screen = Events(eventsScreen)
		
	#creates seperate window for each feature

class Timer:
		def __init__(self, root):
			root.title("Timer")
			root.geometry("800x600")
			self.root = root
			
			self.timerLabel = tk.Label(self.root, text = "TIMER MODE", font=("Arial", 15))
			self.timerLabel.place(y=5, x=300, width = 200, height = 50)
			
			self.countdownBtn = tk.Button(self.root, text = "COUNTDOWN", command=self.countdownWindow)
			self.countdownBtn.place(y=75,x=250, width=300, height=50)
			
			self.stopwatchBtn = tk.Button(self.root, text = "STOPWATCH", command = self.stopwatchWindow)
			self.stopwatchBtn.place(y=145, x=250, width=300, height=50)
			
		def countdownWindow(self):
			countdownScreen = tk.Toplevel(self.root)
			screen = Countdown(countdownScreen)
		
		def stopwatchWindow(self):
			stopwatchScreen = tk.Toplevel(self.root)
			screen = Stopwatch(stopwatchScreen)

